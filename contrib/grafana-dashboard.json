        "spec": {
          "id": 1,
          "title": "Narinfo cache hit ratio",
          "description": "Fraction of narinfo lookups served from the route cache instead of racing upstreams.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(rate(ncro_narinfo_cache_hits_total[$__rate_interval])) / clamp_min(sum(rate(ncro_narinfo_cache_hits_total[$__rate_interval])) + sum(rate(ncro_narinfo_cache_misses_total[$__rate_interval])), 1)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
